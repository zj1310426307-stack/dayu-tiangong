# 本地演示数据库配置；生产环境请使用密钥管理服务。
POSTGRES_DB=dayu_tiangong
POSTGRES_USER=dayu
POSTGRES_PASSWORD=dayu_dev
BACKEND_PORT=8001
FRONTEND_PORT=8080
GEOSERVER_PORT=8081

# GeoServer 密码必须在本地忽略的 .env 或密钥管理系统中设置，禁止提交真实值。
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_DB_USER=dayu_geoserver
GEOSERVER_DB_PASSWORD=
GEOSERVER_JAVA_OPTS=-Xms256m -Xmx768m
VITE_GEOSERVER_TARGET=http://127.0.0.1:8081

# DGIS 开源服务最小权限账号与本地端口；所有密码仅放在被忽略的 .env。
MARTIN_DB_USER=dayu_martin
MARTIN_DB_PASSWORD=
MARTIN_PORT=3000
TITILER_PORT=8002
GEONODE_PORT=8082
GEONODE_DB_USER=dayu_geonode
GEONODE_DB_PASSWORD=
GEONODE_DATA_DB_USER=dayu_geonode_data
GEONODE_DATA_DB_PASSWORD=
GEONODE_ADMIN_USER=admin
GEONODE_ADMIN_PASSWORD=
GEONODE_ADMIN_EMAIL=admin@example.invalid
GEONODE_SECRET_KEY=
GEONODE_OAUTH2_CLIENT_ID=
GEONODE_OAUTH2_CLIENT_SECRET=

# 默认使用本地可追溯回答；启用兼容 LLM 时必须同时配置以下三项。
AI_LLM_PROVIDER=local
AI_LLM_BASE_URL=
AI_LLM_MODEL=
AI_LLM_API_KEY=
