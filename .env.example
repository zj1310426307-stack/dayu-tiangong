# 本地演示数据库配置；生产环境请使用密钥管理服务。
POSTGRES_DB=dayu_tiangong
POSTGRES_USER=dayu
POSTGRES_PASSWORD=dayu_dev
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=8080
GEOSERVER_PORT=8081

# 运行构建身份：本地开发必须显式标为未验证；CI/release 必须改为实际 40 位 Git SHA。
DAYU_ENGINE_VERSION=dayu-hydraulic-platform-5.0.0
DAYU_BUILD_MODE=development
ENGINE_COMMIT=development-unverified

# Standard 1D uses the MASCARET v9.1.1 Adapter. The stock Dayu image does not
# bundle MASCARET; leave disabled until the official runtime is installed and
# the selected executable/container has been verified by the operator.
MASCARET_ENABLED=0
MASCARET_RUNTIME=external
MASCARET_EXECUTABLE=mascaret
# Enabling external execution requires the reviewed native executable SHA-256,
# official runtime data directory, and immutable build provenance.
MASCARET_EXECUTABLE_SHA256=
MASCARET_DATA_DIR=
MASCARET_UPSTREAM_TAG=v9.1.1
MASCARET_UPSTREAM_COMMIT=1fe3b5141f7d9c9fa8fe6d6d0316c994a39c2d95
MASCARET_BUILD_TIMESTAMP=
# Enabling container execution requires image@sha256:<64 hex>, never a mutable tag.
MASCARET_CONTAINER_IMAGE=
MASCARET_TIMEOUT=3600
HYDRAULIC_WORKSPACE_ROOT=backend/storage/hydraulic-workspaces
# success keeps successful jobs; failed keeps failed diagnostics; debug/benchmark keep all.
MASCARET_RETENTION_CLASS=failed
MASCARET_RETENTION_MAX_WORKSPACES=20

# API 与 Worker 的唯一文件存储根；相对路径统一以仓库根解析。
DAYU_STORAGE_ROOT=backend/storage
# Compose 宿主机持久化目录；容器内根固定为 /app/backend/storage。
DAYU_STORAGE_HOST_PATH=../backend/storage

# GeoServer 密码必须在本地忽略的 .env 或密钥管理系统中设置，禁止提交真实值。
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=
GEOSERVER_DB_USER=dayu_geoserver
GEOSERVER_DB_PASSWORD=
GEOSERVER_JAVA_OPTS=-Xms256m -Xmx768m

# QGIS 受控生产链账号；密码只能放在被忽略的 .env / QGIS Auth Manager。
QGIS_EDITOR_DB_USER=dayu_qgis_editor
QGIS_EDITOR_DB_PASSWORD=
QGIS_REVIEWER_DB_USER=dayu_qgis_reviewer
QGIS_REVIEWER_DB_PASSWORD=
# 发布者是 NOLOGIN 服务组角色，不配置桌面客户端密码。
QGIS_PUBLISHER_DB_USER=dayu_publisher

# API/Worker 使用非 owner 登录；本地 .env 可引用 POSTGRES_PASSWORD，生产必须使用独立密钥。
BACKEND_DB_USER=dayu_backend
BACKEND_DB_PASSWORD=

# 默认使用本地可追溯回答；启用兼容 LLM 时必须同时配置以下三项。
AI_LLM_PROVIDER=local
AI_LLM_BASE_URL=
AI_LLM_MODEL=
AI_LLM_API_KEY=
